# SK Edits Backend — Environment Variables Template
# Copy this file to .env for local development or set these variables in Vercel Project Settings.

# Server Environment
NODE_ENV=production
PORT=5000

# Frontend Domain for CORS (Set this to your Vercel frontend URL, e.g. https://sk-edits.vercel.app)
FRONTEND_URL=
CORS_ORIGIN=

# Supabase Project Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: Service Role Key (Keep secret! Do not expose anywhere)
# SUPABASE_SERVICE_ROLE_KEY=

# Secret key used to sign and verify JWT authentication tokens (generate a long random string)
JWT_SECRET=
